name "linux-secret-service"
description "Linux Secret Service backend for credentials-d"
authors "Alexander Bernardi"
copyright "Copyright © 2026 Alexander Bernardi"
license "MIT"

targetType "library"
sourcePaths "source"

dependency "credentials-d" path="../.."

libs "secret-1" "gio-2.0" "gobject-2.0" "glib-2.0" platform="linux"
toolchainRequirements frontend=">=2.111.0"

// Keep generated API docs focused on the supported consumer surface.
x:ddoxFilterArgs "--unittest-examples" "--min-protection" "Public" "--ex" "credentials.backend." "--in" "credentials.linux"
