name "fido2-vault"
description "FIDO2 hmac-secret vault unlock protector for credentials-d"
targetType "library"

sourcePaths "source"

dependency "credentials-d:encrypted-vault" path="../.."

libs "fido2"

toolchainRequirements frontend=">=2.111.0"

// Keep generated API docs focused on the supported consumer surface.
x:ddoxFilterArgs "--unittest-examples" "--min-protection" "Public" "--ex" "credentials.backend." "--in" "credentials.security_key"
